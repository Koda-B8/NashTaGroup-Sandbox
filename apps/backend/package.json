{
	"name": "backend",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --env-file=.env --watch src/server.js",
		"start": "node src/server.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"db": "sequelize --options-path .sequelizerc.cjs",
		"db:create": "npm run db db:create",
		"db:migrate": "npm run db db:migrate",
		"db:migrate:undo": "npm run db db:migrate:undo",
		"db:migrate:undo:all": "npm run db db:migrate:undo:all",
		"db:seed": "npm run db db:seed:all",
		"db:seed:undo": "npm run db db:seed:undo:all",
		"db:setup": "npm run db:create && npm run db:migrate && npm run db:seed"
	},
	"dependencies": {
		"@scalar/express-api-reference": "^0.10.18",
		"argon2": "^0.45.1",
		"cloudinary": "^2.11.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"express-rate-limit": "^8.7.0",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.23.0",
		"redis": "^6.2.1",
		"sequelize": "^6.37.8",
		"sequelize-cli": "^6.6.5",
		"swagger-jsdoc": "^6.3.0"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.5.0",
		"@types/swagger-jsdoc": "^6.0.4"
	}
}
