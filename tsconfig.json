{
	"extends": ["@kekkon-nexus/config/ts"],
	"compilerOptions": {
		// Environment
		"lib": ["esnext"],
		"types": ["*"],

		"skipLibCheck": true,

		// JavaScript
		"allowJs": true,
		"checkJs": true,
		"noImplicitAny": false,
		"noUncheckedIndexedAccess": false
	},
	"references": [{ "path": "apps/backend" }, { "path": "apps/frontend" }]
}
