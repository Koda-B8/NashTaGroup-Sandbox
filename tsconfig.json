{
	"extends": ["@kekkon-nexus/config/ts"],
	"compilerOptions": {
		// Environment
		"lib": ["esnext", "dom"],
		"types": ["*", "vite-plus/client"],

		"noEmit": true,
		"skipLibCheck": true,

		// JavaScript
		"allowJs": true,
		"checkJs": true,
		"noImplicitAny": false,
		"noUncheckedIndexedAccess": false
	}
}
